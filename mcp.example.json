{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/"
    },
    "obsidian": {
      "command": "npx",
      "args": [
        "@bitbonsai/mcpvault@latest",
        "<some path>"
      ],
      "exposure": "hidden"
    },
  }
}
